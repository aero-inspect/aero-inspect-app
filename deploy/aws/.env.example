# No completar a mano: lo genera scripts/generate-secrets.sh con contraseñas aleatorias.
# Este archivo solo documenta qué variables usa compose.yml.

# IP elástica en formato sslip.io (3.14.15.92 -> 3-14-15-92.sslip.io), o localhost para probar.
DOMAIN=

POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
MINIO_PASSWORD=
# 32+ caracteres. El monolito no arranca sin esto.
JWT_SECRET=
# El monolito se conecta a Mosquitto como el usuario "monolith" (ver mosquitto/acl).
MQTT_MONOLITH_PASSWORD=

# API key gratuita de https://openweathermap.org/api. Vacía: /api/v1/weather responde 502.
OPENWEATHER_API_KEY=
WEATHER_MOCK_ENABLED=false
